{
  "name": "thinking-cap",
  "version": "0.1.0",
  "private": true,
  "description": "Free, open-source forehead guessing game for family game night",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc && vite build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "typecheck": "tsc",
    "decks": "node scripts/check-decks.mjs --stats",
    "e2e": "node e2e/smoke.mjs",
    "android:sync": "npm run build && cap sync android",
    "android:open": "cap open android"
  },
  "license": "GPL-3.0-or-later",
  "dependencies": {
    "@capacitor/android": "^8.6.3",
    "@capacitor/core": "^8.6.3",
    "@capacitor/screen-orientation": "^8.0.2",
    "@fontsource/fredoka": "^5.3.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.3",
    "playwright": "^1.65.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.2"
  }
}
